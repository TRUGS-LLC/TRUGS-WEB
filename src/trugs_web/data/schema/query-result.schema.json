{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trugs.org/schema/query-result-v1.json",
  "title": "trugs-web query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "nodes",
    "edges",
    "paths",
    "total_weight",
    "avg_weight",
    "high_credibility_count"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "query": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "$ref": "#/$defs/edge"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "total_weight": {
      "type": "number"
    },
    "avg_weight": {
      "type": "number"
    },
    "high_credibility_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "properties",
        "metric_level"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "metric_level": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "from_id",
        "to_id",
        "relation",
        "weight"
      ],
      "properties": {
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
